{
  "name": "hanul-hwpx",
  "displayName": "Hanul · 한울 HWP/HWPX",
  "description": "한컴 설치 없이 사용하는 로컬 HWP/HWPX 편집기 · 초기 시제품",
  "version": "0.1.0",
  "publisher": "hanul-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "hwp",
    "hwpx",
    "한글",
    "editor"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "hanul": "./dist/cli.mjs",
    "hanul-mcp": "./dist/mcp.mjs"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "hanul.editor",
        "displayName": "한울 한글 편집기",
        "selector": [
          {
            "filenamePattern": "*.hwpx"
          },
          {
            "filenamePattern": "*.hwp"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "hanul.new",
        "title": "한울: 새 HWPX 문서"
      },
      {
        "command": "hanul.open",
        "title": "한울: HWP/HWPX 문서 열기"
      },
      {
        "command": "hanul.demo",
        "title": "한울: 예제 문서 만들기"
      }
    ],
    "configuration": {
      "title": "한울",
      "properties": {
        "hanul.backupBeforeSave": {
          "type": "boolean",
          "default": true,
          "description": "덮어쓰기 전에 원본을 파일명.hanul-backup으로 보관합니다."
        }
      }
    }
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:vscode": "node scripts/test-vscode.mjs",
    "preview": "node scripts/preview.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --out artifacts/hanul-hwpx-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3"
  }
}
